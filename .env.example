# ============================================
# codeserver-ai Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
#
# Dokploy Variable Hierarchy (highest priority first):
#   1. Service Environment Variables
#   2. Project Environment Variables
#   3. Environment-Level Variables
#
# Reference syntax in Dokploy:
#   ${{environment.VARIABLE_NAME}}
#   ${{project.VARIABLE_NAME}}
# ============================================


# ============================================
# ENVIRONMENT LEVEL
# Shared across ALL projects
# Store secrets and API keys here
# ============================================

# ---- AI Provider API Keys ----
OPENROUTER_API_KEY=your-openrouter-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GITHUB_TOKEN=your-github-token

# ---- FreeLLMAPI Encryption ----
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ---- RustFS Credentials ----
RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key


# ============================================
# PROJECT LEVEL
# Shared across all services in this project
# ============================================

# ---- Code Server ----
CS_PASSWORD=changeme
CODESERVER_VERSION=4.123.0
TARGETARCH=amd64

# ---- Gitea ----
GITEA_DOMAIN=gitea.yourdomain.com

# ---- RustFS ----
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=code-server-backups

# ---- Timezone ----
TZ=UTC


# ============================================
# SERVICE LEVEL
# Used by one service only
# ============================================

# ---- Code Server Service ----
CS_DEFAULT_WORKSPACE=/workspace

# ---- Gitea Service ----
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=changeme
GITEA_ADMIN_EMAIL=admin@yourdomain.com

# ---- FreeLLMAPI Service ----
GOOGLE_API_KEY=your-google-api-key
NIM_API_KEY=your-nvidia-nim-api-key
OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key

# ---- RustFS Service ----
RUSTFS_ROOT_USER=admin
RUSTFS_ROOT_PASSWORD=changeme


# ============================================
# DOKPLOY REFERENCE SYNTAX
# ============================================
#
# In Dokploy, reference variables from higher levels using:
#
#   Environment Level:  ${{environment.VARIABLE_NAME}}
#   Project Level:      ${{project.VARIABLE_NAME}}
#
# Example in Service Environment:
#   OPENROUTER_API_KEY=${{environment.OPENROUTER_API_KEY}}
#   GITEA_DOMAIN=${{project.GITEA_DOMAIN}}
#
# ============================================
# DOCKER IMAGES BUILT FROM SOURCE
# ============================================
#
# Service       Source                                    Build Method
# -----------   ---------------------------------------   --------
# code-server   coder/code-server (GitHub releases)       .deb package
# gitea         go-gitea/gitea (git submodule)            Multi-stage Go build
# freellmapi    tashfeenahmed/freellmapi (git submodule)  Multi-stage Node.js build
# rustfs        rustfs/rustfs (git submodule)             Binary download
#
# To update: ./scripts/update.sh
# ============================================
