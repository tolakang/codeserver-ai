# Code Server AI - Environment Configuration
# Copy this file to .env and fill in your values
# CI/CD systems should replace ${{project.*}} placeholders with actual values

# =============================================================================
# AI Provider Configuration (Environment Level)
# =============================================================================

# OpenRouter Provider
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=${{project.OPENROUTER_API_KEY}}

# OpenCode Zen Provider
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/api/v1
OPENCODE_ZEN_API_KEY=${{project.OPENCODE_ZEN_API_KEY}}

# FreeLLMAPI Provider
FRELLMAPI_BASE_URL=http://freellmapi:3000/v1
FRELLMAPI_API_KEY=${{project.FRELLMAPI_API_KEY}}

# Anthropic Provider
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=${{project.ANTHROPIC_API_KEY}}

# OpenAI Provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=${{project.OPENAI_API_KEY}}

# Default Provider (openrouter|opencode-zen|freellmapi|anthropic|openai)
DEFAULT_PROVIDER=freellmapi

# =============================================================================
# Encryption
# =============================================================================

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=${{project.ENCRYPTION_KEY}}

# =============================================================================
# RustFS / S3 Backup Credentials (Environment Level)
# =============================================================================

RUSTFS_ACCESS_KEY=${{project.RUSTFS_ACCESS_KEY}}
RUSTFS_SECRET_KEY=${{project.RUSTFS_SECRET_KEY}}
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=code-server-backups

# =============================================================================
# Code Server (Project Level)
# =============================================================================

# Code server version (see https://github.com/coder/code-server/releases)
CODESERVER_VERSION=${{project.CODESERVER_VERSION}}

# Password for code-server authentication (REQUIRED)
CS_PASSWORD=${{project.CS_PASSWORD}}

# Default workspace path
CS_DEFAULT_WORKSPACE=/workspace

# =============================================================================
# Gitea (Project Level)
# =============================================================================

# Gitea domain (REQUIRED)
GITEA_DOMAIN=${{project.GITEA_DOMAIN}}

# Gitea admin credentials (REQUIRED)
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=${{project.GITEA_ADMIN_PASSWORD}}
GITEA_ADMIN_EMAIL=${{project.GITEA_ADMIN_EMAIL}}

# =============================================================================
# OpenCode WEB (Service Level)
# =============================================================================

# OpenCode WEB version
OPENCODE_VERSION=latest

# OpenCode WEB credentials (REQUIRED)
OPENCODE_SERVER_PASSWORD=${{project.OPENCODE_SERVER_PASSWORD}}
OPENCODE_SERVER_USERNAME=opencode

# =============================================================================
# FreeLLMAPI (Service Level)
# =============================================================================

# FreeLLMAPI version
FREELLM_VERSION=latest

# =============================================================================
# RustFS (Service Level)
# =============================================================================

# RustFS root credentials
RUSTFS_ROOT_USER=admin
RUSTFS_ROOT_PASSWORD=${{project.RUSTFS_ROOT_PASSWORD}}

# =============================================================================
# General
# =============================================================================

# Timezone
TZ=${{project.TZ}}
