# Code Server AI - Environment Configuration
# =============================================================================
# How to Use This File
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in real values in the Environment Section below
# 3. Set those same values in Dokploy's Environment Variables UI
# 4. The ${{project.*}} placeholders in docker-compose files resolve at deploy time

# Docker Compose uses ${{project.VAR}} syntax → Dokploy resolves at deploy time
# Scripts inside containers use ${VAR} syntax → Docker injects values at runtime

# =============================================================================
# ENVIRONMENT SECTION (Set These in Dokploy)
# =============================================================================
# All values are set directly in Dokploy's Environment Variables UI
# These are the source values that ${{project.*}} placeholders resolve to.

# --- Timezone ---
TZ=UTC

# --- Code Server ---
CS_PASSWORD=your-secure-password
CS_DEFAULT_WORKSPACE=/workspace

# --- AI Provider: FreeLLMAPI (self-hosted, recommended) ---
DEFAULT_PROVIDER=freellmapi
FREELLMAPI_BASE_URL=http://freellmapi:3000/v1
FREELLMAPI_API_KEY=your-freellmapi-key

# --- AI Provider: OpenRouter ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-your-openrouter-key

# --- AI Provider: OpenCode Zen ---
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/api/v1
OPENCODE_ZEN_API_KEY=your-opencode-zen-key

# --- AI Provider: Anthropic ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key

# --- AI Provider: OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key

# --- RustFS / S3 Backup Credentials ---
RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=code-server-backups

# --- RustFS Admin ---
RUSTFS_ROOT_USER=admin
RUSTFS_ROOT_PASSWORD=your-rustfs-password

# --- Encryption (generate with: openssl rand -hex 32) ---
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# --- Gitea ---
GITEA_DOMAIN=gitea.yourdomain.com
GITEA_ROOT_URL=https://gitea.yourdomain.com
GITEA_DB_USER=gitea
GITEA_DB_NAME=gitea
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=your-gitea-password
GITEA_ADMIN_EMAIL=admin@yourdomain.com
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=6432
POSTGRES_PASSWORD=your-postgres-password

# --- OpenCode WEB ---
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=your-opencode-password
OPENCODE_WEB_PORT=4001
OPENCODE_WEB_HOSTNAME=0.0.0.0

# --- Service Versions (override in Dokploy if needed) ---
CODESERVER_VERSION=4.123.0
GITEA_VERSION=1.23.0
FREELLMAPI_VERSION=latest
OPENCODE_VERSION=latest

# =============================================================================
# PROJECT SECTION (Cross-Reference Guide)
# =============================================================================
# Shows which variables each service requires.
# These entries are documentation only; generate .env with scripts/resolve-env.sh.

# --- Variables used as ${{project.VAR}} in code-server service:
TZ=${ENVIRONMENT.TZ}
CS_PASSWORD=${ENVIRONMENT.CS_PASSWORD}
CS_DEFAULT_WORKSPACE=${ENVIRONMENT.CS_DEFAULT_WORKSPACE}
DEFAULT_PROVIDER=${ENVIRONMENT.DEFAULT_PROVIDER}
OPENROUTER_BASE_URL=${ENVIRONMENT.OPENROUTER_BASE_URL}
OPENROUTER_API_KEY=${ENVIRONMENT.OPENROUTER_API_KEY}
OPENCODE_ZEN_BASE_URL=${ENVIRONMENT.OPENCODE_ZEN_BASE_URL}
OPENCODE_ZEN_API_KEY=${ENVIRONMENT.OPENCODE_ZEN_API_KEY}
FREELLMAPI_BASE_URL=${ENVIRONMENT.FREELLMAPI_BASE_URL}
FREELLMAPI_API_KEY=${ENVIRONMENT.FREELLMAPI_API_KEY}
ANTHROPIC_BASE_URL=${ENVIRONMENT.ANTHROPIC_BASE_URL}
ANTHROPIC_API_KEY=${ENVIRONMENT.ANTHROPIC_API_KEY}
OPENAI_BASE_URL=${ENVIRONMENT.OPENAI_BASE_URL}
OPENAI_API_KEY=${ENVIRONMENT.OPENAI_API_KEY}
RUSTFS_ACCESS_KEY=${ENVIRONMENT.RUSTFS_ACCESS_KEY}
RUSTFS_SECRET_KEY=${ENVIRONMENT.RUSTFS_SECRET_KEY}
RUSTFS_ENDPOINT=${ENVIRONMENT.RUSTFS_ENDPOINT}
RUSTFS_BUCKET=${ENVIRONMENT.RUSTFS_BUCKET}
ENCRYPTION_KEY=${ENVIRONMENT.ENCRYPTION_KEY}
POSTGRES_HOST=${ENVIRONMENT.POSTGRES_HOST}
POSTGRES_PORT=${ENVIRONMENT.POSTGRES_PORT}
POSTGRES_USER=${ENVIRONMENT.GITEA_DB_USER}
POSTGRES_DB=${ENVIRONMENT.GITEA_DB_NAME}
POSTGRES_PASSWORD=${ENVIRONMENT.POSTGRES_PASSWORD}

# --- Variables used as ${{project.VAR}} in freellmapi service:
TZ=${ENVIRONMENT.TZ}
ENCRYPTION_KEY=${ENVIRONMENT.ENCRYPTION_KEY}
FREELLMAPI_VERSION=${ENVIRONMENT.FREELLMAPI_VERSION}

# --- Variables used as ${{project.VAR}} in gitea service:
GITEA_DOMAIN=${ENVIRONMENT.GITEA_DOMAIN}
GITEA_ROOT_URL=${ENVIRONMENT.GITEA_ROOT_URL}
GITEA_DB_USER=${ENVIRONMENT.GITEA_DB_USER}
GITEA_DB_NAME=${ENVIRONMENT.GITEA_DB_NAME}
POSTGRES_PASSWORD=${ENVIRONMENT.POSTGRES_PASSWORD}
GITEA_ADMIN_USER=${ENVIRONMENT.GITEA_ADMIN_USER}
GITEA_ADMIN_PASSWORD=${ENVIRONMENT.GITEA_ADMIN_PASSWORD}
GITEA_ADMIN_EMAIL=${ENVIRONMENT.GITEA_ADMIN_EMAIL}
GITEA_VERSION=${ENVIRONMENT.GITEA_VERSION}

# --- Variables used as ${{project.VAR}} in opencode-web service:
OPENCODE_SERVER_USERNAME=${ENVIRONMENT.OPENCODE_SERVER_USERNAME}
OPENCODE_SERVER_PASSWORD=${ENVIRONMENT.OPENCODE_SERVER_PASSWORD}
OPENCODE_WEB_PORT=${ENVIRONMENT.OPENCODE_WEB_PORT}
OPENCODE_WEB_HOSTNAME=${ENVIRONMENT.OPENCODE_WEB_HOSTNAME}
TZ=${ENVIRONMENT.TZ}
FREELLMAPI_API_KEY=${ENVIRONMENT.FREELLMAPI_API_KEY}

# --- Variables used as ${{project.VAR}} in rustfs service:
RUSTFS_ROOT_USER=${ENVIRONMENT.RUSTFS_ROOT_USER}
RUSTFS_ROOT_PASSWORD=${ENVIRONMENT.RUSTFS_ROOT_PASSWORD}

# =============================================================================
# SERVICE SECTION (Service-Specific Overrides)
# =============================================================================
# Override individual service settings here if needed
# These values take precedence over the Project Level

# Example: Override code-server port
# CODE_SERVER_PORT=8080

# Example: Override gitea SSH port
# GITEA_SSH_PORT=2222
