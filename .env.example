# Code Server AI - Environment Configuration
# =============================================================================
# How to Use This File
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in real values in the ENVIRONMENT section below
# 3. Set those same values in Dokploy's Environment Variables UI
# 4. The ${{project.*}} placeholders in docker-compose files resolve at deploy time
#
# Docker Compose uses ${{project.VAR}} syntax → Dokploy resolves at deploy time
# Scripts inside containers use ${VAR} syntax → Docker injects values at runtime

# =============================================================================
# ENVIRONMENT SECTION (Set These in Dokploy)
# =============================================================================
# All values are set directly in Dokploy's Environment Variables UI.
# These are the source values that ${{project.*}} placeholders resolve to.

# --- Timezone ---
TZ=UTC

# --- Code Server ---
CS_PASSWORD=your-secure-password
CS_DEFAULT_WORKSPACE=/workspace

# --- AI Provider: FreeLLMAPI (self-hosted, recommended) ---
DEFAULT_PROVIDER=freellmapi
FRELLMAPI_BASE_URL=http://freellmapi:3000/v1
FRELLMAPI_API_KEY=your-freellmapi-key

# --- AI Provider: OpenRouter ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-your-openrouter-key

# --- AI Provider: OpenCode Zen ---
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/api/v1
OPENCODE_ZEN_API_KEY=your-opencode-zen-key

# --- AI Provider: Anthropic ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key

# --- AI Provider: OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key

# --- RustFS / S3 Backup Credentials ---
RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=code-server-backups

# --- RustFS Admin ---
RUSTFS_ROOT_USER=admin
RUSTFS_ROOT_PASSWORD=your-rustfs-password

# --- Encryption (generate with: openssl rand -hex 32) ---
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# --- Gitea ---
GITEA_DOMAIN=gitea.yourdomain.com
GITEA_DB_USER=gitea
GITEA_DB_NAME=gitea
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=your-gitea-password
GITEA_ADMIN_EMAIL=admin@yourdomain.com
POSTGRES_PASSWORD=your-postgres-password

# --- OpenCode WEB ---
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=your-opencode-password

# --- Service Versions (override in Dokploy if needed) ---
CODESERVER_VERSION=4.123.0
GITEA_VERSION=1.23.0
FREELLM_VERSION=latest
OPENCODE_VERSION=latest

# =============================================================================
# PROJECT SECTION (Cross-Reference Guide)
# =============================================================================
# Shows which variables each service requires.
# The variable names here match the ${{project.*}} placeholders in docker-compose files.
# Set corresponding values in Dokploy's Environment Variables UI.

# --- docker-compose.code-server.yml ---
# Variables used as ${{project.VAR}} in code-server service:
#   TZ, CS_PASSWORD, CS_DEFAULT_WORKSPACE, DEFAULT_PROVIDER,
#   OPENROUTER_BASE_URL, OPENROUTER_API_KEY,
#   OPENCODE_ZEN_BASE_URL, OPENCODE_ZEN_API_KEY,
#   FRELLMAPI_BASE_URL, FRELLMAPI_API_KEY,
#   ANTHROPIC_BASE_URL, ANTHROPIC_API_KEY,
#   OPENAI_BASE_URL, OPENAI_API_KEY,
#   RUSTFS_ACCESS_KEY, RUSTFS_SECRET_KEY, RUSTFS_ENDPOINT, RUSTFS_BUCKET,
#   ENCRYPTION_KEY
#   Build arg: CODESERVER_VERSION

# --- docker-compose.freellmapi.yml ---
# Variables used as ${{project.VAR}} in freellmapi service:
#   TZ, ENCRYPTION_KEY
#   Build arg: FREELLM_VERSION

# --- docker-compose.gitea.yml ---
# Variables used as ${{project.VAR}} in gitea, postgres, pgbouncer services:
#   GITEA_DOMAIN, GITEA_DB_USER, GITEA_DB_NAME, POSTGRES_PASSWORD
#   Build arg: GITEA_VERSION

# --- docker-compose.opencode-web.yml ---
# Variables used as ${{project.VAR}} in opencode-web service:
#   TZ, OPENCODE_SERVER_PASSWORD, OPENCODE_SERVER_USERNAME, FRELLMAPI_API_KEY
#   Build arg: OPENCODE_VERSION

# --- docker-compose.rustfs.yml ---
# Variables used as ${{project.VAR}} in rustfs service:
#   RUSTFS_ROOT_USER, RUSTFS_ROOT_PASSWORD

# =============================================================================
# SERVICE SECTION (Service-Specific Overrides)
# =============================================================================
# Override individual service settings here if needed.
# These values take precedence over the Project Level.

# Example: Override code-server port
# CODE_SERVER_PORT=8080

# Example: Override gitea SSH port
# GITEA_SSH_PORT=2222
