# Code Server AI - Environment Configuration
# Copy this file to .env and fill in your values
# CI/CD systems should replace ${{project.*}} placeholders with actual values

# =============================================================================
# Main Section (Real Values - Edit These)
# =============================================================================
# Edit values here once, then reference them from lower sections via placeholders.
# All variables here are prefixed with PROJECT_ to distinguish them as source values.

# OpenRouter Provider
PROJECT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROJECT_OPENROUTER_API_KEY=sk-your-openrouter-key

# OpenCode Zen Provider
PROJECT_OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/api/v1
PROJECT_OPENCODE_ZEN_API_KEY=your-opencode-zen-key

# FreeLLMAPI Provider
PROJECT_FRELLMAPI_BASE_URL=http://freellmapi:3000/v1
PROJECT_FRELLMAPI_API_KEY=your-freellmapi-key

# Anthropic Provider
PROJECT_ANTHROPIC_BASE_URL=https://api.anthropic.com
PROJECT_ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI Provider
PROJECT_OPENAI_BASE_URL=https://api.openai.com/v1
PROJECT_OPENAI_API_KEY=sk-your-openai-key

# Default Provider (openrouter|opencode-zen|freellmapi|anthropic|openai)
PROJECT_DEFAULT_PROVIDER=freellmapi

# Encryption Key (generate with: openssl rand -hex 32)
PROJECT_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# RustFS / S3 Backup Credentials
PROJECT_RUSTFS_ACCESS_KEY=your-rustfs-access-key
PROJECT_RUSTFS_SECRET_KEY=your-rustfs-secret-key
PROJECT_RUSTFS_ENDPOINT=http://rustfs:9000
PROJECT_RUSTFS_BUCKET=code-server-backups

# Code Server Configuration
PROJECT_CODESERVER_VERSION=4.123.0
PROJECT_CS_PASSWORD=your-secure-password
PROJECT_CS_DEFAULT_WORKSPACE=/workspace

# Gitea Configuration
PROJECT_GITEA_DOMAIN=gitea.yourdomain.com
PROJECT_GITEA_ADMIN_USER=admin
PROJECT_GITEA_ADMIN_PASSWORD=your-gitea-password
PROJECT_GITEA_ADMIN_EMAIL=admin@yourdomain.com

# OpenCode WEB Configuration
PROJECT_OPENCODE_VERSION=latest
PROJECT_OPENCODE_SERVER_USERNAME=opencode
PROJECT_OPENCODE_SERVER_PASSWORD=your-opencode-password

# FreeLLMAPI Configuration
PROJECT_FREELLM_VERSION=latest

# RustFS Configuration
PROJECT_RUSTFS_ROOT_USER=admin
PROJECT_RUSTFS_ROOT_PASSWORD=your-rustfs-password

# General Configuration
PROJECT_TZ=UTC

# =============================================================================
# Environment Level (Shared Global Secrets)
# =============================================================================
# These variables are shared across multiple services.
# They reference the Main Section values via ${{project.*}} placeholders.

# OpenRouter Provider
OPENROUTER_BASE_URL=${{project.OPENROUTER_BASE_URL}}
OPENROUTER_API_KEY=${{project.OPENROUTER_API_KEY}}

# OpenCode Zen Provider
OPENCODE_ZEN_BASE_URL=${{project.OPENCODE_ZEN_BASE_URL}}
OPENCODE_ZEN_API_KEY=${{project.OPENCODE_ZEN_API_KEY}}

# FreeLLMAPI Provider
FRELLMAPI_BASE_URL=${{project.FRELLMAPI_BASE_URL}}
FRELLMAPI_API_KEY=${{project.FRELLMAPI_API_KEY}}

# Anthropic Provider
ANTHROPIC_BASE_URL=${{project.ANTHROPIC_BASE_URL}}
ANTHROPIC_API_KEY=${{project.ANTHROPIC_API_KEY}}

# OpenAI Provider
OPENAI_BASE_URL=${{project.OPENAI_BASE_URL}}
OPENAI_API_KEY=${{project.OPENAI_API_KEY}}

# Default Provider
DEFAULT_PROVIDER=${{project.DEFAULT_PROVIDER}}

# Encryption Key
ENCRYPTION_KEY=${{project.ENCRYPTION_KEY}}

# RustFS / S3 Backup Credentials
RUSTFS_ACCESS_KEY=${{project.RUSTFS_ACCESS_KEY}}
RUSTFS_SECRET_KEY=${{project.RUSTFS_SECRET_KEY}}
RUSTFS_ENDPOINT=${{project.RUSTFS_ENDPOINT}}
RUSTFS_BUCKET=${{project.RUSTFS_BUCKET}}

# =============================================================================
# Project Level Configuration
# =============================================================================
# Settings that define this specific project instance.

# Code Server Configuration
CODESERVER_VERSION=${{project.CODESERVER_VERSION}}
CS_PASSWORD=${{project.CS_PASSWORD}}
CS_DEFAULT_WORKSPACE=${{project.CS_DEFAULT_WORKSPACE}}

# Gitea Configuration
GITEA_DOMAIN=${{project.GITEA_DOMAIN}}
GITEA_ADMIN_USER=${{project.GITEA_ADMIN_USER}}
GITEA_ADMIN_PASSWORD=${{project.GITEA_ADMIN_PASSWORD}}
GITEA_ADMIN_EMAIL=${{project.GITEA_ADMIN_EMAIL}}

# OpenCode WEB Configuration
OPENCODE_VERSION=${{project.OPENCODE_VERSION}}
OPENCODE_SERVER_USERNAME=${{project.OPENCODE_SERVER_USERNAME}}
OPENCODE_SERVER_PASSWORD=${{project.OPENCODE_SERVER_PASSWORD}}

# FreeLLMAPI Configuration
FREELLM_VERSION=${{project.FREELLM_VERSION}}

# RustFS Configuration
RUSTFS_ROOT_USER=${{project.RUSTFS_ROOT_USER}}
RUSTFS_ROOT_PASSWORD=${{project.RUSTFS_ROOT_PASSWORD}}

# General Configuration
TZ=${{project.TZ}}

# =============================================================================
# Service Level (Service-Specific Overrides)
# =============================================================================
# Override individual service settings here if needed.
# These values take precedence over the Project Level.

# Example: Override code-server port
# CODE_SERVER_PORT=8080

# Example: Override gitea SSH port
# GITEA_SSH_PORT=2222
