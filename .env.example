# ============================================
# codeserver-ai Complete Environment Configuration
# ============================================
# This file documents ALL three Dokploy variable levels in one place.
#
# DOKPLOY VARIABLE HIERARCHY (highest priority first):
#   1. Service Level    → Set in: App > Configuration > Environment Variables
#   2. Project Level    → Set in: Project Settings > Environment Variables
#   3. Environment Level → Set in: Environment Settings > Environment Variables
#
# REFERENCE SYNTAX:
#   Project → Environment:  ${{environment.VAR_NAME}}
#   Service → Project:      ${{project.VAR_NAME}}
#   Service → Environment:  ${{environment.VAR_NAME}}
#
# USAGE:
#   - Copy Environment Level section to Dokploy Environment Settings
#   - Copy Project Level section to Dokploy Project Settings
#   - Copy relevant Service Level section to each App's Configuration
# ============================================


# ============================================
# 1. ENVIRONMENT LEVEL (Source of Truth)
# ============================================
# Set in: Dokploy > Environment Settings > Environment Variables
# Shared across ALL projects on this Dokploy instance
# NO references - these are the actual secret values
# ============================================

# ---- AI Provider API Keys ----
OPENROUTER_API_KEY=your-openrouter-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GITHUB_TOKEN=your-github-token

# ---- FreeLLMAPI Encryption ----
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ---- RustFS Credentials ----
RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key


# ============================================
# 2. PROJECT LEVEL (Shared Config)
# ============================================
# Set in: Dokploy > Project Settings > Environment Variables
# Shared across all services in this project
# Can reference Environment Level with ${{environment.VAR}}
# ============================================

# ---- Code Server ----
CS_PASSWORD=changeme
CODESERVER_VERSION=4.123.0
# TARGETARCH=amd64  # Auto-detected by Docker/buildx; do not override

# ---- Gitea ----
GITEA_VERSION=1.23.0
GITEA_DOMAIN=https://gitea.example.com

# ---- FreeLLMAPI ----
FREELLM_VERSION=latest

# ---- PostgreSQL (for Gitea) ----
# Generate with: openssl rand -base64 32 | tr -d "=+/" | cut -c1-25
POSTGRES_PASSWORD=your-postgres-password

# ---- RustFS ----
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=code-server-backups

# ---- Timezone ----
TZ=UTC

# ---- Optional: Pull secrets from Environment Level to Project scope ----
# Uncomment if you need these at Project level:
# GITHUB_TOKEN=${{environment.GITHUB_TOKEN}}
# OPENROUTER_API_KEY=${{environment.OPENROUTER_API_KEY}}
# ENCRYPTION_KEY=${{environment.ENCRYPTION_KEY}}
# RUSTFS_ACCESS_KEY=${{environment.RUSTFS_ACCESS_KEY}}
# RUSTFS_SECRET_KEY=${{environment.RUSTFS_SECRET_KEY}}


# ============================================
# 3. SERVICE LEVEL (Per-Service Config)
# ============================================
# Set in: Dokploy > Each App > Configuration > Environment Variables
# Copy ONLY the relevant service section below
# References: ${{project.VAR}} or ${{environment.VAR}}
# ============================================


# --------------------------------------------
# 3a. CODE-SERVER SERVICE
# --------------------------------------------
CS_DEFAULT_WORKSPACE=/workspace
CS_PASSWORD=${{project.CS_PASSWORD}}
CODESERVER_VERSION=${{project.CODESERVER_VERSION}}
TZ=${{project.TZ}}


# --------------------------------------------
# 3b. FREELLMAPI SERVICE
# --------------------------------------------
# Note: Provider API keys (Google, NIM, OpenCode Zen, OpenRouter, GitHub,
# Groq, Cerebras, Mistral, etc.) are NOT set here.
# They are configured through the FreeLLMAPI dashboard → Keys page.
# Keys are stored encrypted in the internal SQLite database.
# The only required environment variable is ENCRYPTION_KEY.
FREELLM_VERSION=${{project.FREELLM_VERSION}}
TZ=${{project.TZ}}
ENCRYPTION_KEY=${{environment.ENCRYPTION_KEY}}


# --------------------------------------------
# 3c. GITEA SERVICE
# --------------------------------------------
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=changeme
GITEA_ADMIN_EMAIL=admin@yourdomain.com
GITEA_VERSION=${{project.GITEA_VERSION}}
GITEA_DOMAIN=${{project.GITEA_DOMAIN}}
POSTGRES_PASSWORD=${{project.POSTGRES_PASSWORD}}
TZ=${{project.TZ}}


# --------------------------------------------
# 3d. RUSTFS SERVICE
# --------------------------------------------
RUSTFS_ROOT_USER=admin
RUSTFS_ROOT_PASSWORD=changeme
RUSTFS_ENDPOINT=${{project.RUSTFS_ENDPOINT}}
RUSTFS_BUCKET=${{project.RUSTFS_BUCKET}}
RUSTFS_ACCESS_KEY=${{environment.RUSTFS_ACCESS_KEY}}
RUSTFS_SECRET_KEY=${{environment.RUSTFS_SECRET_KEY}}


# ============================================
# QUICK REFERENCE: VARIABLE → LEVEL MAPPING
# ============================================
#
# Variable                    | Env Level | Project Level | Service Level
# ----------------------------|-----------|---------------|------------------
# ANTHROPIC_API_KEY           | ✓ actual  | -             | -
# OPENAI_API_KEY              | ✓ actual  | -             | -
# ENCRYPTION_KEY              | ✓ actual  | optional ref  | freellmapi: ${{environment.}}
# RUSTFS_ACCESS_KEY           | ✓ actual  | optional ref  | rustfs: ${{environment.}}
# RUSTFS_SECRET_KEY           | ✓ actual  | optional ref  | rustfs: ${{environment.}}
# CS_PASSWORD                 | -         | ✓ actual      | code-server: ${{project.}}
# CODESERVER_VERSION          | -         | ✓ actual      | code-server: ${{project.}}
# GITEA_VERSION               | -         | ✓ actual      | gitea: ${{project.}}
# GITEA_DOMAIN                | -         | ✓ actual      | gitea: ${{project.}}
# POSTGRES_PASSWORD           | -         | ✓ actual      | gitea: ${{project.}}
# FREELLM_VERSION             | -         | ✓ actual      | freellmapi: ${{project.}}
# RUSTFS_ENDPOINT             | -         | ✓ actual      | rustfs: ${{project.}}
# RUSTFS_BUCKET               | -         | ✓ actual      | rustfs: ${{project.}}
# TZ                          | -         | ✓ actual      | all: ${{project.}}
# CS_DEFAULT_WORKSPACE        | -         | -             | code-server: actual
# GITEA_ADMIN_USER            | -         | -             | gitea: actual
# GITEA_ADMIN_PASSWORD        | -         | -             | gitea: actual
# GITEA_ADMIN_EMAIL           | -         | -             | gitea: actual
# RUSTFS_ROOT_USER            | -         | -             | rustfs: actual
# RUSTFS_ROOT_PASSWORD        | -         | -             | rustfs: actual
# ============================================
# DOCKER IMAGES BUILT FROM SOURCE
# ============================================
#
# Service       Source                                    Build Method
# -----------   ---------------------------------------   --------
# code-server   coder/code-server (GitHub releases)       .deb package
# gitea         go-gitea/gitea (git submodule)            Multi-stage Go build
# freellmapi    tashfeenahmed/freellmapi (git submodule)  Multi-stage Node.js build
# rustfs        rustfs/rustfs (git submodule)             Binary download
#
# To update: ./scripts/update.sh
# ============================================