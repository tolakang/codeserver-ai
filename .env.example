# Code Server AI - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Provider Configuration (Environment Level)
# =============================================================================

# OpenRouter Provider
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenCode Zen Provider
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/api/v1
OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key

# FreeLLMAPI Provider
FRELLMAPI_BASE_URL=http://freellmapi:3000/v1
FRELLMAPI_API_KEY=your-freellmapi-api-key

# Anthropic Provider
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI Provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key

# Default Provider (openrouter|opencode-zen|freellmapi|anthropic|openai)
DEFAULT_PROVIDER=freellmapi

# =============================================================================
# Encryption
# =============================================================================

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# =============================================================================
# RustFS / S3 Backup Credentials (Environment Level)
# =============================================================================

RUSTFS_ACCESS_KEY=your-access-key
RUSTFS_SECRET_KEY=your-secret-key
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=code-server-backups

# =============================================================================
# Code Server (Project Level)
# =============================================================================

# Code server version (see https://github.com/coder/code-server/releases)
CODESERVER_VERSION=4.123.0

# Password for code-server authentication (REQUIRED)
CS_PASSWORD=your-secure-password

# Default workspace path
CS_DEFAULT_WORKSPACE=/workspace

# =============================================================================
# Gitea (Project Level)
# =============================================================================

# Gitea domain (REQUIRED)
GITEA_DOMAIN=gitea.yourdomain.com

# Gitea admin credentials (REQUIRED)
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=your-secure-password
GITEA_ADMIN_EMAIL=admin@yourdomain.com

# =============================================================================
# OpenCode WEB (Service Level)
# =============================================================================

# OpenCode WEB version
OPENCODE_VERSION=latest

# OpenCode WEB credentials (REQUIRED)
OPENCODE_SERVER_PASSWORD=your-secure-password
OPENCODE_SERVER_USERNAME=opencode

# =============================================================================
# FreeLLMAPI (Service Level)
# =============================================================================

# FreeLLMAPI version
FREELLM_VERSION=latest

# =============================================================================
# RustFS (Service Level)
# =============================================================================

# RustFS root credentials
RUSTFS_ROOT_USER=admin
RUSTFS_ROOT_PASSWORD=your-secure-password

# =============================================================================
# General
# =============================================================================

# Timezone
TZ=UTC
