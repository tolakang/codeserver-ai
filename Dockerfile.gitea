# Dockerfile.gitea
# Build from official go-gitea/gitea source
# Source: https://github.com/go-gitea/gitea

# syntax=docker/dockerfile:1

# Build frontend on the native platform to avoid QEMU-related issues
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26-alpine3.23 AS frontend-build

RUN apk --no-cache add build-base git nodejs pnpm
WORKDIR /src

RUN git clone --depth 1 https://github.com/go-gitea/gitea.git .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
RUN make frontend

# Build backend for each target platform
FROM docker.io/library/golang:1.26-alpine3.23 AS build-env

ARG TAGS=""
ENV TAGS="bindata timetzdata $TAGS"

RUN apk --no-cache add build-base git

WORKDIR ${GOPATH}/src/gitea.dev

RUN git clone --depth 1 https://github.com/go-gitea/gitea.git .
COPY --from=frontend-build /src/public/assets public/assets

RUN --mount=type=cache,target="/root/.cache/go-build" \
    --mount=type=bind,source=".git/",target=".git/" \
    make backend

COPY docker/root /tmp/local

RUN chmod 755 /tmp/local/usr/bin/entrypoint \
              /tmp/local/usr/local/bin/* \
              /tmp/local/etc/s6/gitea/* \
              /tmp/local/etc/s6/openssh/* \
              /tmp/local/etc/s6/.s6-svscan/*

# Final stage
FROM docker.io/library/alpine:3.23

RUN apk --no-cache add \
    bash \
    ca-certificates \
    curl \
    gettext \
    git \
    linux-pam \
    openssh \
    s6 \
    sqlite \
    su-exec \
    gnupg

RUN addgroup -S -g 1000 git && \
    adduser -S -H -D -h /data/git -s /bin/bash -u 1000 -G git git && \
    echo "git:*" | chpasswd -e

COPY --from=build-env /tmp/local /
COPY --from=build-env /go/src/gitea.dev/gitea /app/gitea/gitea

ENV USER=git
ENV GITEA_CUSTOM=/data/gitea

EXPOSE 22 3000

VOLUME ["/data"]

ENTRYPOINT ["/usr/bin/entrypoint"]
CMD ["/usr/bin/s6-svscan", "/etc/s6"]
